# Supabase project connection details for the STREAM UG frontend.
# Copy this file to `.env` (which is git-ignored) and fill in the values from
# your Supabase project dashboard: Project Settings -> API.
#
# VITE_SUPABASE_URL is the "Project URL", e.g. https://xxxxxxxx.supabase.co
# Use the base project URL only — do NOT append /rest/v1/ or any other API
# path; the Supabase client library adds that internally.
# VITE_SUPABASE_ANON_KEY is the "anon public" (or "publishable") API key.
#
# Both values are safe to expose in a browser bundle; row-level security (RLS)
# policies on your Supabase tables are what actually protect your data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: bootstrap password for the mock/local-dev admin account
# (admin.streamug@gmail.com), used only when the Supabase vars above are NOT set.
# Without this, the mock admin account has no usable password. Never commit
# a real password here — this file is a template; set it in your local,
# git-ignored `.env` only. See the "Admin access" section of the README.
VITE_MOCK_ADMIN_PASSWORD=admin123
